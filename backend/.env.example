# ─────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────
PORT=5000

# ─────────────────────────────────────────────
# MongoDB Atlas Connection
# Replace with your own MongoDB Atlas URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>
# ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/abdrax_lms?appName=Cluster0

# ─────────────────────────────────────────────
# JWT Configuration
# Use a strong random secret key (min 32 chars)
# ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────
NODE_ENV=development
